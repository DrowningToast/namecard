---
import { NameCard } from "@/components/landing/NameCard";
import { Section } from "@/components/landing/Section/index";
import { SkillsCarousel } from "@/components/landing/SkillsCarousel";
import { EncryptedText } from "@/components/ui/encrypted-text";
import { Activities } from "@/constants/activities";
import { Education } from "@/constants/education";
import { Projects } from "@/constants/projects";
import { SideProjects } from "@/constants/side-projects";
import { WorkExperience } from "@/constants/work-experience";
import Base from "@/layouts/Base.astro";
---

<Base>
	<div class="relative z-10 flex flex-col items-stretch p-4 gap-y-16">
		<NameCard />

		{/* The résumé lives at its own `/resume` route, reached from the navbar. */}
		<div class="flex flex-col items-stretch gap-y-16 -mt-8">
			<Section
				header="Experience"
				sectionViewmodels={WorkExperience}
				client:load
			/>
			<Section header="Education" sectionViewmodels={Education} client:load />
			<div class="flex flex-col items-stretch gap-y-4">
				<h3 class="text-2xl lg:text-4xl font-bold">
					<EncryptedText
						client:idle
						text="I'm capable of.."
						revealedClassName="text-primary"
						encryptedClassName="text-primary/20"
						revealDelayMs={100}
						flipDelayMs={10}
					/>
				</h3>
				<div class="text-foreground w-full mb-4">
					<SkillsCarousel client:visible />
				</div>
			</div>
			<Section header="Projects" sectionViewmodels={Projects} client:load />
			<Section
				header="Side Projects"
				sectionViewmodels={SideProjects}
				client:idle
			/>
			<Section header="Activities" sectionViewmodels={Activities} client:load />
		</div>
	</div>
</Base>
